// Test wildcard patterns in case expressions
// expect: "matched"

let _ = case Just 42 of _ -> "matched" | Nothing -> "not matched"
let _ = case [1, 2, 3] of _ -> "list matched" | [] -> "empty"
let _ = case (1, "hello") of _ -> "tuple matched"
let _ = case Just 42 of _ -> "bound" | Nothing -> "none"
case Nothing of _ -> "matched" | Just x -> "should not match"
