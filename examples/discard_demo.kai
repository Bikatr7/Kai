// Discard keeps side-effect-only helpers small and composable.
let log = \message -> discard (print ("[log] " ++ message))
let report = {user = "Kai", steps = ["read", "type-check", "run"]}
do {
  log "starting example";
  log ("pipeline: " ++ join ", " (report.steps));
  print ("Final report: " ++ show report)
}
