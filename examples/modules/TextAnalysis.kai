// expect: ()
// expect-type: TUnit
// TextAnalysis.kai - A small reusable analysis module built from StringUtils and MathUtils.
import StringUtils
import MathUtils
let wordCount : String -> Int = \text -> length (words text)
let characterCount : String -> Int = \text -> strLength text
let averageWordLength : String -> Int = \text -> average (map (\word -> strLength word) (words text))
let longestWordLength : String -> Int = \text -> case maximum (map (\word -> strLength word) (words text)) of Just n -> n | Nothing -> 0
let firstLongWord : Int -> String -> Maybe String = \minLength -> \text -> case filter (\word -> strLength word > minLength) (words text) of [] -> Nothing | word :: _ -> Just word
let preview : String -> String = \text -> previewWords 5 text
let summarize : String -> {words: Int, characters: Int, averageWordLength: Int, longestWordLength: Int, preview: String, firstLongWord: Maybe String} = \text -> {words = wordCount text, characters = characterCount text, averageWordLength = averageWordLength text, longestWordLength = longestWordLength text, preview = preview text, firstLongWord = firstLongWord 4 text}
let formatSummary : String -> String = \text -> let summary = summarize text in "Words: " ++ (toString (summary.words)) ++ "\nCharacters: " ++ (toString (summary.characters)) ++ "\nAverage word length: " ++ (toString (summary.averageWordLength)) ++ "\nLongest word length: " ++ (toString (summary.longestWordLength)) ++ "\nPreview: " ++ summary.preview ++ "\nFirst long word: " ++ (case summary.firstLongWord of Just word -> word | Nothing -> "none")
export wordCount, characterCount, averageWordLength, longestWordLength, firstLongWord, preview, summarize, formatSummary
