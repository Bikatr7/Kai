// StringUtils.kai - String manipulation utilities
let words = \s -> filter (\w -> w != "") (split " " (trim s))

let toLower = \s ->
  let lowerMap = [
    ("A", "a"), ("B", "b"), ("C", "c"), ("D", "d"), ("E", "e"),
    ("F", "f"), ("G", "g"), ("H", "h"), ("I", "i"), ("J", "j"),
    ("K", "k"), ("L", "l"), ("M", "m"), ("N", "n"), ("O", "o"),
    ("P", "p"), ("Q", "q"), ("R", "r"), ("S", "s"), ("T", "t"),
    ("U", "u"), ("V", "v"), ("W", "w"), ("X", "x"), ("Y", "y"),
    ("Z", "z")
  ] in
  foldl (\acc -> \(upper, lower) -> replace upper lower acc) s lowerMap

export words, toLower
