// expect: ()
// expect-type: TUnit
// Count words in a file with module reuse and explicit CLI validation.
import TextAnalysis
let validateArgs : [String] -> Either String String = \cliArgs -> case cliArgs of [] -> Left "Usage: kai examples/file_counter.kai <file>" | path :: _ -> Right path
case validateArgs args of Left message -> print message | Right path -> let summary = summarize (readFile path) in print (path ++ ": " ++ (toString (summary.words)) ++ " words, longest word length " ++ (toString (summary.longestWordLength)))
