// expect: ()
// expect-type: TUnit
// Wildcards across Either, records, tuples, and lists.
let result = case Right {ok = true, message = "loaded"} of Right {ok = true, message = _} -> "status: success" | Left _ -> "status: failure" | Right _ -> "status: unexpected"
let tupleSummary = case (42, "kai", true) of (_, name, true) -> "tuple for " ++ name | _ -> "tuple mismatch"
let listSummary = case [1, 2, 3, 4] of _ :: _ -> "list has values" | [] -> "list is empty"
do {
  print result;
  print tupleSummary;
  print listSummary
}
