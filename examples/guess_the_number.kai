// expect-type: TUnit
// Interactive guessing game with optional CLI-configured secret number.
let parseDefaultSecret : String -> Int = (\value ->
  case parseInt value of
    Just n -> n
    | Nothing -> 42
)
let parseSecret : [String] -> Int = (\cliArgs ->
  case cliArgs of
    value :: _ -> parseDefaultSecret value
    | [] -> 42
)
let promptGuess : Int -> String = (\attempt -> do {
  print ("Attempt " ++ (toString attempt) ++ ": enter a guess");
  input
})
letrec loop : Int -> Int -> Unit = (\secret -> \attempt ->
  let guessText = promptGuess attempt in
  case parseInt guessText of
    Just guess -> if guess == secret then print ("Correct in " ++ (toString attempt) ++ " tries!") else if guess < secret then do {
      print "Too low.";
      loop secret (attempt + 1)
    } else do {
      print "Too high.";
      loop secret (attempt + 1)
    }
    | Nothing -> do {
        print "Please enter an integer.";
        loop secret attempt
      }
)
do {
  print "Guess a number between 1 and 100.";
  loop (parseSecret args) 1
}
