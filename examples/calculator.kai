// expect-type: TUnit
// Interactive calculator using typed validation and Either-driven control flow.
let parseNumber : String -> String -> Either String Int = (\label -> \text ->
  case parseInt text of
    Just n -> Right n
    | Nothing -> Left (label ++ " value must be an Int.")
)
let parseNumbers = (\leftText -> \rightText ->
  case parseNumber "First" leftText of
    Right left ->
      case parseNumber "Second" rightText of
        Right right -> Right (left, right)
        | Left message -> Left message
    | Left message -> Left message
)
let chooseOperation = (\choice ->
  if choice == "1" then Right ("add", \x -> \y -> x + y)
  else if choice == "2" then Right ("subtract", \x -> \y -> x - y)
  else if choice == "3" then Right ("multiply", \x -> \y -> x * y)
  else if choice == "4" then Right ("divide", \x -> \y -> x / y)
  else if choice == "5" then Left "exit"
  else Left "Choose 1, 2, 3, 4, or 5."
)
let prompt : String -> String = (\label -> do {
  print label;
  input
})
letrec loop : Unit -> Unit = (\_ ->
  do {
    print "=== Kai Calculator ===";
    print "1) add  2) subtract  3) multiply  4) divide  5) exit";
    let choice = prompt "Choose an option:" in
      case chooseOperation choice of
        Left "exit" -> print "Goodbye."
        | Left message -> do {
            print message;
            loop ()
          }
        | Right (name, op) ->
            let leftText = prompt "First number:" in
            let rightText = prompt "Second number:" in
            case parseNumbers leftText rightText of
              Left message -> do {
                print message;
                loop ()
              }
              | Right (left, right) -> do {
                  print (name ++ " => " ++ toString (op left right));
                  loop ()
                }
  }
)
loop ()
