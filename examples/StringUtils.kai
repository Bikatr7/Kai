// expect-type: TUnit
// StringUtils.kai - Text helpers for scripts.
let words : String -> [String] = \text -> filter (\word -> not (word == "")) (split " " (trim text))
let csvFields : String -> [String] = \line -> filter (\field -> not (field == "")) (map (\field -> trim field) (split "," line))
let previewWords : Int -> String -> String = \limit -> \text -> join " | " (take limit (words text))
let firstNonEmpty : [String] -> Maybe String = \values -> case filter (\value -> not (trim value == "")) values of [] -> Nothing | value :: _ -> Just (trim value)
export words, csvFields, previewWords, firstNonEmpty
