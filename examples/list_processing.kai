// expect: ()
// expect-type: TUnit
// Records, zips, and let-polymorphism over a small report pipeline.
let numbers = [5, 8, 13, 21, 34, 55]
let even = \n -> n - (n / 2 * 2) == 0
let report = {count = length numbers, evenCount = length (filter even numbers), total = foldl (\acc -> \n -> acc + n) 0 numbers, labels = zip numbers (map (\n -> if n > 20 then "high" else "steady") numbers)}
let tag = \label -> \value -> {label = label, value = value}
do {
  print ("Report: " ++ show report);
  print ("Tagged total: " ++ show (tag "total" (report.total)));
  print ("Tagged status: " ++ show (tag "status" "ready"))
}
