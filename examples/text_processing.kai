// expect-type: TUnit
// Use the reusable StringUtils example module for practical text cleanup.
import StringUtils
let csvLine = " apples , bananas ,  pears ,  "
let cleaned = csvFields csvLine
let preview = previewWords 4 "Kai examples should stay typed and practical"
do {
  print ("Fields: " ++ show cleaned);
  print ("Preview: " ++ preview);
  case firstNonEmpty ["", "  ", "focus"] of Just value -> print ("First non-empty: " ++ value) | Nothing -> print "First non-empty: none"
}
